# Copia este archivo como .env y edítalo:   copy .env.example .env

# Tu usuario de Docker Hub (las imágenes se llaman <usuario>/zv-pista, zv-cliente, ...)
DOCKERHUB_USUARIO=tuusuario
TAG=1.0

# Zona horaria de los registros y del tablero
TZ=America/Bogota

# Las mallas de Pepper y NAO son de SoftBank Robotics (qibullet) y tienen licencia propia.
# Léela (https://github.com/softbankrobotics-research/qibullet) y, si estás de acuerdo, pon "si".
QIBULLET_ACEPTO_LICENCIA=no

# Umbrales del plano de administración para marcar un contenedor como DEGRADADO
UMBRAL_LATENCIA_MS=50
UMBRAL_JITTER_MS=20
UMBRAL_PERDIDA_PCT=5
